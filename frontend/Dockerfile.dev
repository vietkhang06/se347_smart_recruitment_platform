# Development Dockerfile for MatchaJob Frontend
FROM node:22-alpine

WORKDIR /app

# Copy dependency manifests
# Note: package-lock.json is absent in this repository, using npm install
COPY package.json ./

# Install dependencies
RUN npm install

# Copy application source code
COPY . .

# Expose Vite development server port
EXPOSE 5173

# Start development server with host 0.0.0.0
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
