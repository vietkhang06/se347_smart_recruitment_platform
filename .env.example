# ==============================================================================
# MatchaJob Environment Variables Template
# Copy this file to .env and adjust variables as needed for local development:
#   cp .env.example .env
# Configured to strictly avoid port conflicts with MidCV (Đồ Án 1):
#   - MidCV DB: 5432     -> MatchaJob DB: 5433
#   - MidCV Front: 3000  -> MatchaJob Front: 5173
#   - MidCV Back: 8080   -> MatchaJob Back: 8081
#   - MidCV AI: 8000     -> MatchaJob AI: 8001
# ==============================================================================

# ------------------------------------------------------------------------------
# Project & Global Configuration
# ------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=matchajob
APP_ENV=development

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite + React 19)
# ------------------------------------------------------------------------------
FRONTEND_HOST_PORT=5173
FRONTEND_CONTAINER_PORT=5173
# Public API URL used by the browser to reach the backend (Port 8081 avoids conflict with MidCV Port 8080)
VITE_API_BASE_URL=http://localhost:8081/api

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16 with pgvector)
# Port 5433 on host to avoid conflict with existing PostgreSQL on port 5432 (MidCV)
# ------------------------------------------------------------------------------
POSTGRES_HOST_PORT=5433
POSTGRES_CONTAINER_PORT=5432
POSTGRES_DB=matchajob_db
POSTGRES_USER=matchajob_user
POSTGRES_PASSWORD=matchajob_password

# ------------------------------------------------------------------------------
# Backend Configuration (Spring Boot) - Ready for when backend source is integrated
# Port 8081 on host to avoid conflict with MidCV backend on port 8080
# ------------------------------------------------------------------------------
BACKEND_HOST_PORT=8081
BACKEND_CONTAINER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://database:5432/matchajob_db
SPRING_DATASOURCE_USERNAME=matchajob_user
SPRING_DATASOURCE_PASSWORD=matchajob_password
AI_WORKER_BASE_URL=http://ai-worker:8000

# ------------------------------------------------------------------------------
# AI Worker Configuration (FastAPI) - Ready for when AI worker source is integrated
# Port 8001 on host to avoid conflict with MidCV AI worker on port 8000
# ------------------------------------------------------------------------------
AI_WORKER_HOST_PORT=8001
AI_WORKER_CONTAINER_PORT=8000
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=your_ai_api_key_here
