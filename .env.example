# ==============================================================================
# MatchaJob Environment Variables Template
# Copy to .env for an isolated local demo; adjust published ports if occupied.
# ==============================================================================

# ------------------------------------------------------------------------------
# Project & Global Configuration
# ------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=matchajob-demo
APP_ENV=development

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite + React 19)
# ------------------------------------------------------------------------------
FRONTEND_HOST_PORT=5173
FRONTEND_CONTAINER_PORT=5173
VITE_DATA_SOURCE=api
# Public API URL used by the browser; keep its port in sync with BACKEND_HOST_PORT.
VITE_API_BASE_URL=http://127.0.0.1:8081/api

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16 with pgvector)
# ------------------------------------------------------------------------------
# Database is private to the Compose network; no host port is published.
POSTGRES_DB=matchajob_db
POSTGRES_USER=matchajob_user
POSTGRES_PASSWORD=replace_with_private_demo_password

# ------------------------------------------------------------------------------
# Backend Configuration (Spring Boot)
# ------------------------------------------------------------------------------
BACKEND_HOST_PORT=8081
BACKEND_CONTAINER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# Backend database connection is derived from POSTGRES_* in Compose.
AI_WORKER_BASE_URL=http://ai-worker:8000

# Backend storage is mounted at /data/cv in the Compose named volume.
MATCHAJOB_CV_MAX_FILE_SIZE=10MB
MATCHAJOB_CV_MAX_REQUEST_SIZE=11MB
MATCHAJOB_CV_PROCESSING_ENABLED=true
MATCHAJOB_CV_PROCESSING_POLL_DELAY_MS=2000

# ------------------------------------------------------------------------------
# AI Worker Configuration (FastAPI; private to the Compose network)
# ------------------------------------------------------------------------------
AI_WORKER_CONTAINER_PORT=8000
AI_PROVIDER=deterministic
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# Demo-only signing key. Replace before using this outside an isolated local demo.
JWT_SECRET=dGhpc19pc19hX3Zlcnlfc2VjdXJlX2p3dF9zZWNyZXRfa2V5X2Zvcl9tYXRjaGFqb2JfZGV2XzIwMjY=
