{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "overall_score",
    "skills_score",
    "experience_score",
    "breakdown",
    "rationale"
  ],
  "properties": {
    "overall_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "skills_score": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "experience_score": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "breakdown": {
      "type": "object"
    },
    "rationale": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
